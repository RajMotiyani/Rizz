# Free Gemini API key: https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=
# Models tried in order; the next one is used when one runs out of free daily quota.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite

# Random long string used to sign the device cookie: `openssl rand -hex 32`
SESSION_SECRET=change-me

# Optional locally, required on Vercel/serverless: Upstash Redis REST (free plan is enough).
# Without these, usage counts are kept in .data/store.json (single server only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Replies per device per day (protects the shared free AI quota)
REPLIES_PER_DAY=50
REPLIES_PER_IP_PER_DAY=150

# Optional upgrade: use Claude instead of Gemini (paid, about ₹1.5-2 per generation)
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=

# --- Login (email code) + user database ---
# Login switches on automatically once BREVO_API_KEY and EMAIL_FROM are set.
# Supabase (free): Project Settings > API. Run supabase/schema.sql in the SQL Editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Brevo (free, 300 emails/day): SMTP & API > API Keys. EMAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=
