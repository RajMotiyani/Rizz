# AI provider. Free option: a Gemini API key from https://aistudio.google.com/apikey (no card needed).
# If GEMINI_API_KEY is set, Gemini is used; otherwise Claude. AI_PROVIDER=gemini|claude forces one.
GEMINI_API_KEY=
# Models tried in order; the next one is used when one runs out of free daily quota.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional paid upgrade: Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Razorpay test keys (Dashboard > Settings > API Keys, Test mode)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# Random long string used to sign the device cookie: `openssl rand -hex 32`
SESSION_SECRET=change-me

# Optional in local dev, required on Vercel/serverless: Upstash Redis REST
# Without these, usage data is kept in .data/store.json (single server only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pricing / limits (defaults shown)
FREE_REPLIES_PER_DAY=5
PASS_PRICE_PAISE=4900
PASS_DAYS=7
